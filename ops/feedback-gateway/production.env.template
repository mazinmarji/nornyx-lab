# Runtime configuration for the Nornyx feedback gateway — NON-SECRET values only.
#
# Copy nothing into git. Export these in the deployment environment (or let
# fly.toml's [env] block carry them on Fly). The token deliberately has no
# line here: NORNYX_FEEDBACK_GITHUB_TOKEN must be injected by the platform's
# runtime secret mechanism (`flyctl secrets set`, a systemd credential, a
# CI-less shell export at `docker compose up` time) and must never exist in
# a file, an image layer, a build argument, or a log.

NORNYX_FEEDBACK_GITHUB_REPOSITORY=mazinmarji/nornyx-lab-feedback
NORNYX_FEEDBACK_DESTINATION_VISIBILITY=private
NORNYX_FEEDBACK_DB=/var/lib/nornyx-feedback/gateway.db

# Optional knobs, shown with their defaults:
# NORNYX_FEEDBACK_GITHUB_API=https://api.github.com
# NORNYX_FEEDBACK_GITHUB_TIMEOUT_SECONDS=10
# NORNYX_FEEDBACK_ISSUE_LABELS=learner-feedback
# NORNYX_FEEDBACK_MAX_BODY_BYTES=65536
# NORNYX_FEEDBACK_RATE_LIMIT_PER_MINUTE=30
